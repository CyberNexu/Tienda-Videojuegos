package proyecto;


	import java.util.ArrayList;
	import java.util.Scanner;

	public class tienda {

	    static class Videojuego {
	        String nombre;
	        double precio;

	        Videojuego(String nombre, double precio) {
	            this.nombre = nombre;
	            this.precio = precio;
	        }

	        void mostrar() {
	            System.out.println("Videojuego: " + nombre);
	            System.out.println("Precio: $" + precio);
	        }
	    }

	    public static void main(String[] args) {

	        Scanner sc = new Scanner(System.in);

	        ArrayList<Videojuego> juegos = new ArrayList<>();

	        juegos.add(new Videojuego("Minecraft", 499));
	        juegos.add(new Videojuego("EA Sports FC 26", 1399));
	        juegos.add(new Videojuego("GTA V", 599));
	        juegos.add(new Videojuego("Mario Kart 8", 1099));
	        juegos.add(new Videojuego("FIFA 23", 799));

	        int opcion;

	        do {
	            System.out.println("\n===== TIENDA DE VIDEOJUEGOS =====");
	            System.out.println("1. Mostrar videojuegos");
	            System.out.println("2. Buscar videojuego");
	            System.out.println("3. Comprar videojuego");
	            System.out.println("4. Salir");
	            System.out.print("Elige una opcion: ");
	            opcion = sc.nextInt();
	            sc.nextLine();

	            switch (opcion) {

	                case 1:
	                    System.out.println("\n--- VIDEOJUEGOS DISPONIBLES ---");

	                    for (int i = 0; i < juegos.size(); i++) {
	                        System.out.println("\n[" + (i + 1) + "]");
	                        juegos.get(i).mostrar();
	                    }
	                    break;

	                case 2:
	                    System.out.print("\nEscribe el nombre del videojuego: ");
	                    String buscar = sc.nextLine();

	                    boolean encontrado = false;

	                    for (Videojuego juego : juegos) {
	                        if (juego.nombre.equalsIgnoreCase(buscar)) {
	                            System.out.println("\nVideojuego encontrado:");
	                            juego.mostrar();
	                            encontrado = true;
	                        }
	                    }

	                    if (!encontrado) {
	                        System.out.println("No se encontro el videojuego.");
	                    }
	                    break;

	                case 3:
	                    System.out.println("\n--- COMPRAR VIDEOJUEGO ---");

	                    for (int i = 0; i < juegos.size(); i++) {
	                        System.out.println((i + 1) + ". "
	                                + juegos.get(i).nombre
	                                + " - $"
	                                + juegos.get(i).precio);
	                    }

	                    System.out.print("Selecciona un videojuego: ");
	                    int seleccion = sc.nextInt();

	                    if (seleccion >= 1 && seleccion <= juegos.size()) {

	                        Videojuego juego = juegos.get(seleccion - 1);

	                        System.out.println("\nHas seleccionado: " + juego.nombre);
	                        System.out.println("Precio: $" + juego.precio);

	                        System.out.print("¿Cuantos quieres comprar?: ");
	                        int cantidad = sc.nextInt();

	                        double total = juego.precio * cantidad;

	                        System.out.println("\nTotal a pagar: $" + total);
	                        System.out.println("Compra realizada correctamente.");

	                    } else {
	                        System.out.println("Seleccion no valida.");
	                    }

	                    break;

	                case 4:
	                    System.out.println("\nGracias por visitar la tienda.");
	                    break;

	                default:
	                    System.out.println("Opcion no valida.");
	            }

	        } while (opcion != 4);

	        sc.close();
	    }
	}
